# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Supabase > Connect > Transaction pooler (port 6543); used by the migration and RLS-check scripts only
DATABASE_URL=
# Comma-separated free-tier keys; the pool rotates through them
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
# Any long random string; Vercel Cron sends it to /api/cron/purge
CRON_SECRET=
# Optional: the public address (e.g. https://gradelens.vercel.app); otherwise taken from the request
NEXT_PUBLIC_SITE_URL=
